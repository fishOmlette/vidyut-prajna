# Copy to .env and fill in your key.
# The app still runs without this key, but chat uses a local deterministic fallback.
GEMINI_API_KEY=sk-your-key-here
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# Optional demo controls
H3_RESOLUTION=8
MAX_CELLS=72
NUM_DAYS=3
FREQ=15min
TRAIN_STEPS=192
FORECAST_STEPS=96
EPOCHS=12
SEED=42
PORT=8050