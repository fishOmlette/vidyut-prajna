# Vidyut Prajna Configuration
# Copy to .env and customize as needed

# =============================================================================
# Server
# =============================================================================
PORT=8050
HOST=127.0.0.1
DEBUG=false

# =============================================================================
# Synthetic Bengaluru Scenario
# =============================================================================
SCENARIO=orr_whitefield          # orr_whitefield | south_residential | central_commercial
H3_RESOLUTION=8                  # H3 hex resolution (8 = ~461m edge)
MAX_CELLS=54                     # Max H3 cells in corridor
NUM_DAYS=7                       # Simulation days
FREQ=1h                          # Time step frequency
SIM_START=2026-05-01             # Simulation start date (May = monsoon season)
SEED=42                          # Random seed for reproducibility

# =============================================================================
# Forecasting (STGCN)
# =============================================================================
# Leave TRAIN_STEPS unset to use automatic split
# TRAIN_STEPS=144
FORECAST_STEPS=24                # Forecast horizon steps
SEQ_LEN=12                       # Input sequence length
HIDDEN_SIZE=48                   # STGCN hidden channels
STGCN_BLOCKS=2                   # Number of STGCN blocks
EPOCHS=10                        # Training epochs
STGCN_MIN_VARIANCE_RATIO=25      # Flatline guardrail threshold (lower = less aggressive fallback)

# =============================================================================
# Infrastructure Planning
# =============================================================================
STATION_BUDGET=8                 # Number of stations to recommend
STATION_KW=22.0                  # Planning increment per station (kW)

# =============================================================================
# Dashboard Performance
# =============================================================================
DASHBOARD_FAST=true              # Enable fast mode (reduced cells/days/epochs)
DASHBOARD_MAX_CELLS=36           # Max cells in fast mode
DASHBOARD_NUM_DAYS=5             # Max days in fast mode
DASHBOARD_EPOCHS=3               # Max epochs in fast mode
DASHBOARD_CACHE=true             # Cache dashboard bootstrap data
DASHBOARD_DEFAULT_TAB=overview   # Default tab on load

# =============================================================================
# Explanation Assistant (Optional)
# =============================================================================
# The dashboard runs without these values using a deterministic local fallback.
# No sensitive data is sent to hosted LLMs - only computed aggregates.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview
