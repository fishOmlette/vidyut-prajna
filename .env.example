# Vidyut Prajna demo configuration

# Dashboard
PORT=8050
DEBUG=false

# Synthetic Bengaluru scenario
SCENARIO=orr_whitefield
H3_RESOLUTION=8
MAX_CELLS=54
NUM_DAYS=7
FREQ=1h
SIM_START=2026-05-01
SEED=42

# Forecast horizon
# Leave TRAIN_STEPS and FORECAST_STEPS unset to use automatic split.
# TRAIN_STEPS=144
FORECAST_STEPS=24

# STGCN model
SEQ_LEN=12
HIDDEN_SIZE=48
STGCN_BLOCKS=2
EPOCHS=10

# Infrastructure planning
STATION_BUDGET=8
STATION_KW=22.0

# Optional grounded LLM explanation layer
# The dashboard runs without these values and uses a deterministic local fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
